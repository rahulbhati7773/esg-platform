# SQLite PoC (default). Copy to .env before running migrations.
DATABASE_URL="file:./dev.db"

# HTTP port for the API (default 5000)
PORT=5000

# Comma-separated browser origins allowed to call the API.
# In development (NODE_ENV=development), any http://localhost:* origin is also allowed
# so Vite can use 5174, 5175, etc. when 5173 is taken.
CORS_ORIGIN=http://localhost:5173

# development | production
NODE_ENV=development
